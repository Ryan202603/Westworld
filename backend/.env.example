# ===== Westworld Backend 配置 =====
# 服务端口
PORT=3000

# 本地 JSON 数据存储目录(相对 backend 目录, 运行时自动创建)
DATA_DIR=data

# ===== 大模型(LLM)配置 =====
# 留空 = 离线 mock 模式(无需任何 key 即可跑通最小闭环, 使用本地分镜算法)
# 填入任意 OpenAI 兼容服务的 key, 同一套代码自动走真实模型
LLM_API_KEY=
# 默认 DeepSeek。想换 OpenAI/豆包/通义/Kimi 等兼容服务, 改这两行即可(通常零代码)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 是否启用 JSON 结构化输出(OpenAI 兼容的 response_format)
LLM_JSON_MODE=true

# ===== 出图模型 =====
# MVP 阶段使用 mock(本地 SVG 占位图, 不消耗任何费用)。将来实现 image provider 后切换
IMAGE_PROVIDER=mock
