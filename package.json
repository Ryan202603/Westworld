{
  "name": "westworld",
  "version": "0.1.0",
  "private": true,
  "description": "Westworld - AI 漫画生成站(文本 → 分镜 → 漫画格)。Monorepo: backend(NestJS) + frontend(Vue3)",
  "scripts": {
    "dev": "pnpm --parallel --filter westworld-backend --filter westworld-frontend run dev",
    "dev:backend": "pnpm --filter westworld-backend run dev",
    "dev:frontend": "pnpm --filter westworld-frontend run dev",
    "build": "pnpm --filter westworld-backend --filter westworld-frontend run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.66.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0"
}
